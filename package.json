{
  "name": "@shipwithai/cumpa",
  "version": "1.5.0",
  "description": "Local-first review of pinned Git comparisons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ship-With-AI/cumpa.git"
  },
  "bugs": {
    "url": "https://github.com/Ship-With-AI/cumpa/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "cumpa": "dist/bin/cumpa.mjs"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:bin": "node scripts/build-bin.mjs",
    "build:node": "tsc --project tsconfig.json",
    "build:runtime": "npm run build:bin && npm run build:node && node scripts/build-native-addon.mjs",
    "build:web": "vite build",
    "typecheck:web": "tsc --noEmit --project tsconfig.web.json",
    "build": "npm run build:runtime && npm run build:web",
    "prepack": "npm run build",
    "verify:prerequisites": "node scripts/verify-prerequisites.mjs && npm run build:runtime",
    "verify:production-artifacts": "node scripts/verify-production-artifacts.mjs",
    "test:unit": "node scripts/run-focused-vitest.mjs tests/unit",
    "test:git": "node scripts/run-focused-vitest.mjs tests/git",
    "test:api": "vitest run tests/api",
    "test:package": "playwright test",
    "test:browser": "playwright test",
    "test:package-export-safety": "node scripts/run-package-export-safety.mjs",
    "pack:runtime-artifact": "node scripts/pack-runtime.mjs",
    "test:package-contract": "npm run build && vitest run --no-file-parallelism tests/package/agent-ready-export-safety.test.ts",
    "accept:runtime-artifact": "vitest run --config vitest.runtime-artifact.config.ts --no-file-parallelism",
    "test:performance": "npm run build:runtime && node tests/performance/production-picker.mjs"
  },
  "dependencies": {
    "@fastify/static": "9.3.0",
    "@inquirer/search": "4.2.1",
    "commander": "15.0.0",
    "fastify": "5.10.0",
    "markdown-it": "14.3.0",
    "monaco-editor": "0.55.1",
    "open": "11.0.0",
    "vue": "3.5.39",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.11.1",
    "@vitejs/plugin-vue": "6.0.7",
    "supabase": "2.114.0",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  }
}
