{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": [
    "src/cli/**/*.ts",
    "src/contracts/**/*.ts",
    "src/git/**/*.ts",
    "src/server/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/git/**/*.ts",
    "tests/api/**/*.ts",
    "tests/cli/**/*.ts",
    "tests/package/**/*.ts",
    "tests/helpers/**/*.ts"
  ],
  "exclude": [
    "tests/unit/agent-ready-export-state.test.ts",
    "tests/unit/comment-groups.test.ts",
    "tests/unit/draft-reconciliation.test.ts",
    "tests/unit/file-tree.test.ts",
    "tests/unit/line-mapping.test.ts",
    "tests/unit/markdown-preview.test.ts",
    "tests/unit/monaco-diff-adapter.test.ts",
    "tests/unit/monaco-diff-semantics.test.ts",
    "tests/unit/monaco-theme.test.ts",
    "tests/unit/workspace-state.test.ts"
  ]
}
